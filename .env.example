HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/carbon.db
PUE=1.4
EMBODIED_G_PER_RUN=0
SAVINGS_THRESHOLD_PCT=5
SAVINGS_THRESHOLD_G=5
SAFETY_BUFFER_MIN=15
SYNTHETIC_SEED=42
# Optional: complete coverage is required; otherwise use labeled synthetic data.
ELECTRICITY_MAPS_TOKEN=
PROVIDER_TIMEOUT_SECONDS=3
PROVIDER_RETRIES=1
PROVIDER_CACHE_SECONDS=300
# Optional explanation only. Disabled by default; never changes decisions.
ENABLE_LLM_EXPLANATIONS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
